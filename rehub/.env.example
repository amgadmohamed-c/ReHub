# ReHub environment variables
# Copy this file to .env and adjust values

DATABASE_URL=postgresql+asyncpg://rehub:rehub_secret@localhost:5432/rehub
DB_ECHO=false
DEBUG=false

WINDOW_SIZE=50
WINDOW_STEP=10
MODEL_DIR=app/ml/models

FATIGUE_THRESHOLD=0.65
STRAIN_THRESHOLD=0.60
INJURY_THRESHOLD=0.55
OVEREXERTION_THRESHOLD=0.70
TEMP_HIGH_THRESHOLD=38.5

WS_HEARTBEAT_INTERVAL=30
